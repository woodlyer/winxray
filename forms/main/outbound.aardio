	fp = {"uTLS指纹";"模拟客户端指纹，可选值：chrome, firefox, safari, ios, android, edge, random, randomized"};
	alpn = {"应用层协商(ALPN)";'TLS/QUIC 应用层协商协议，如 h3, h2, http/1.1'};
	allowInsecure = {"允许忽略证书";"布尔值 true/false。仅用于自签名证书的传统 TLS 节点。\n注意：REALITY 协议使用服务端公钥验证，不支持且不需要此项。"};
	congestion_control = {"TUIC拥塞控制";"可选值为 bbr, cubic, new_reno，默认为 bbr"};
