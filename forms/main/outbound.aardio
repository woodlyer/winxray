	shortId = {"REALITY简短ID";"服务端的 shortId (sid)，十六进制字符串"};
	sid = {"REALITY简短ID";"服务端的 shortId (sid)，十六进制字符串"};
	spiderX = {"REALITY爬虫路径";"客户端发起请求时的伪装爬虫路径，默认 /"};
