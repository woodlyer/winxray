{
    "inbounds": [ // 入站节点，也就是本地代理端口配置
        {
            "listen": "127.0.0.1", // 本机 SOCKS 代理端口，设为 0 时由 winXray 重置为合适的默认端口
            "port": 0, // 本机 SOCKS 代理端口，设为 0 时由 winXray 重置为合适的默认端口
            "protocol": "socks", // 入站代理协议
            "settings": {
                "auth": "noauth",
                "udp": true
            },
            "sniffing": {
                "destOverride": [
                    "http",
                    "tls"
                ],
                "enabled": true,
                "routeOnly": true
            },
            "tag": "proxy" // 名称为"proxy"的节点由 winXray 自动维护并添加用户配置
        },
        {
            "listen": "127.0.0.1",
            "port": 0,
            "protocol": "http",
            "settings": {},
            "sniffing": {
                "destOverride": [
                    "http",
                    "tls"
                ],
                "enabled": true,
                "routeOnly": true
            },
            "tag": "http_proxy" // 名称为"http_proxy"的入站节点由 winXray 自动维护并添加用户配置
        }
    ],
    "log": {
        "access": "",
        "error": "",
        "loglevel": "warning"
    },
    "outbounds": [
        {
            "tag": "proxy" // 名称为"proxy"的节点由 winXray 自动维护并添加用户配置
        },
        {
            "protocol": "freedom",
            "settings": {},
            "tag": "direct"
        },
        {
            "protocol": "blackhole",
            "settings": {
                "response": {
                    "type": "http"
                }
            },
            "tag": "block"
        }
    ],
    "dns": {
        // 强制仅查询 IPv4（A 记录），规避国内残缺 IPv6 导致的网络卡顿、断流及 IPv6 DNS 泄漏
        "queryStrategy": "UseIPv4",
        "servers": [
            // 1. 国内域名解析：优先走阿里 DoH 加密解析，+local 强制本机网络直连，expectIPs 防本地运营商劫持投毒
            {
                "address": "https+local://223.5.5.5/dns-query",
                "domains": [
                    "geosite:cn"
                ],
                "expectIPs": [
                    "geoip:cn"
                ]
            },
            // 2. 国内传统 DNS 备用：阿里标准 UDP 53，用于 DoH 异常或极低延迟直连解析
            {
                "address": "223.5.5.5",
                "port": 53,
                "domains": [
                    "geosite:cn"
                ],
                "expectIPs": [
                    "geoip:cn"
                ]
            },
            // 3. 境外域名定向解析：非大陆域名走 Cloudflare DoH，走代理出站解析，防止 GFW 污染与 DNS 泄漏
            {
                "address": "https://1.1.1.1/dns-query",
                "domains": [
                    "geosite:geolocation-!cn"
                ]
            },
            // 4. 兜底解析服务器列表
            "https://1.1.1.1/dns-query",
            "tcp://8.8.8.8:53",
            "223.5.5.5"
        ]
    },
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "inboundTag": [
                    "api"
                ],
                "outboundTag": "api",
                "type": "field"
            },
            // 国内域名直连
            {
                "domain": [
                    "geosite:cn"
                ],
                "outboundTag": "direct",
                "type": "field"
            },
            // 国内 IP 及私有局域网 IP 直连
            {
                "ip": [
                    "geoip:cn",
                    "geoip:private"
                ],
                "outboundTag": "direct",
                "type": "field"
            }
            // 备用广告拦截规则（需要开启时，去掉前面两行的 // 注释并在上一行末尾添加逗号）：
            // ,{ "domain": ["geosite:category-ads-all"], "outboundTag": "block", "type": "field" }
        ]
    }
}