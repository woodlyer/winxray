//config 配置文件 
import fsys.config;
import fsys;

// 彻底去除对 AppData 的依赖，所有配置全部存放在程序根目录下的 /config/ 目录中
var localCfgDir = io.fullpath("/config/");
var oldAppDir = io.appData("/winXray/");

// 如果本地 /config/ 尚不存在，且旧的 AppData 里有配置数据，自动做一次无缝热迁移
if( !io.exist(localCfgDir) && io.exist(oldAppDir) ){
	fsys.copy( io.joinpath(oldAppDir, "*.*"), localCfgDir );
}

config  = fsys.config( localCfgDir ); 

namespace config {
	__appName = "winXray"; 
	__loadDefaultOutbounds = function(){
		import v2ray.outbounds;
		var serverData =  ..string.load("/v2ray-core/winXray-default-servers.json") 
			: $"/v2ray-core/winXray-default-servers.json"
		
		proxy.outbounds = ..v2ray.outbounds.importFromString(..string.removeBom(serverData));
		..publish("outbounds.updateConfigJson",)
	}
	
	if(!proxy.outbounds){
		__loadDefaultOutbounds();
	}
}

if(!config.proxy.mode) config.proxy.mode = "pac";
if(!config.proxy.pacPort) config.proxy.pacPort = 0;
if(config.proxy.useHttpGlobal===null){
	config.proxy.useHttpGlobal = true;
}
if(config.proxy.useSocksPac===null){
	config.proxy.useSocksPac = _WIN10_LATER;
}

if(config.proxy.enableGitConfigGithub===null){
	config.proxy.enableGitConfigGithub = true;
}

if(config.proxy.test === null){
	config.proxy.test = true;
}

if(config.proxy.autoRefreshSubscription === null){
	config.proxy.autoRefreshSubscription = true;
}

if(!config.proxy.testInterval){
	config.proxy.testInterval = 15;
}

if(!config.proxy.maxTestServers){
	config.proxy.maxTestServers = 100;
}

if(!config.proxy.subscribeUrls){
	config.proxy.subscribeUrls = {
		fields =  {"";"checked";"ps";"url";}
	}
}

if(!config.proxy.hotkey){
	config.proxy.hotkey = {1/*_MOD_ALT*/|2/*_MOD_CONTROL*/|4/*_MOD_SHIFT*/;'P'#}
}

config.__resetDefaultCore = function(){
	config.core.customText = null;
	config.core.default =  {
		inbounds={
			{
				listen="127.0.0.1";
				port=1080;
				protocol="socks";
				settings={
					auth="noauth";
					udp=true;
				};
				sniffing={
					destOverride={
						"http";
						"tls"
					};
					enabled=true;
					routeOnly=true;
				};
				tag="proxy";
			}; 
			{
				listen="127.0.0.1";
				port=1082;
				protocol="http";
				settings={};
				sniffing={
					destOverride={
						"http";
						"tls"
					};
					enabled=true;
					routeOnly=true;
				};
				tag="http_proxy"
			}
		};
		log={
			access="";
			error="";
			loglevel="warning"
		};
		outbounds={
			{
				tag="proxy"
			};
			{
				protocol="freedom";
				settings={};
				tag="direct";
			};
			{
				protocol="blackhole";
				settings={
					response={
						type="http"
					};
				};
				tag="block";
			}
		};
		dns={
			queryStrategy="UseIPv4"; // 强制仅查询 IPv4，规避残缺 IPv6 导致解析卡顿及泄漏
			servers={
				// 国内域名解析：阿里 DoH +local 强制直连，expectIPs 防运营商劫持投毒
				{
					address="https+local://223.5.5.5/dns-query";
					domains={ "geosite:cn" };
					expectIPs={ "geoip:cn" };
				};
				// 国内传统 53 端口备选
				{
					address="223.5.5.5";
					port=53;
					domains={ "geosite:cn" };
					expectIPs={ "geoip:cn" };
				};
				// 境外非大陆域名：走 Cloudflare DoH（走代理出站防污染与泄漏）
				{
					address="https://1.1.1.1/dns-query";
					domains={ "geosite:geolocation-!cn" };
				};
				// 兜底 DNS
				"https://1.1.1.1/dns-query";
				"tcp://8.8.8.8:53";
				"223.5.5.5";
			};
		};
		routing={
			domainStrategy="AsIs";
			rules={
				{
					inboundTag={
						"api"
					};
					outboundTag="api";
					type="field";
				};
				{
					domain={
						"geosite:cn"
					};
					outboundTag="direct";
					type="field";
				};
				{
					ip={
						"geoip:cn";
						"geoip:private"
					};
					outboundTag="direct";
					type="field";
				}
			}
		};
	}	
}

if(!config.core.default || !config.core.default.inbounds || !config.core.default.inbounds[1]){
	config.__resetDefaultCore();
}

if(config.core.default.inbounds[1] && (config.core.default.inbounds[1].port == 10801 || config.core.default.inbounds[1].port == 0)){
	config.core.default.inbounds[1].port = 1080;
}
if(config.core.default.inbounds[2] && (config.core.default.inbounds[2].port == 10802 || config.core.default.inbounds[2].port == 0)){
	config.core.default.inbounds[2].port = 1082;
}

if(!config.core.default.inbounds[2]){
	config.core.default.inbounds[2]	= {
		listen="127.0.0.1";
		port=0;
		protocol="http";
		settings={};
		sniffing={
			destOverride={
				"http";
				"tls"
			};
			enabled=true;
			routeOnly=true;
		};
		tag="http_proxy"
	}
}

if(config.core.default.inbounds){
	for(i,ib in config.core.default.inbounds){
		if(ib.sniffing && (ib.sniffing.routeOnly === null)){
			ib.sniffing.routeOnly = true;
		}
	}
}

if(config.core.default.routing && (config.core.default.routing.domainStrategy == "IPIfNonMatch" || !config.core.default.routing.domainStrategy)){
	config.core.default.routing.domainStrategy = "AsIs";
}

if(!config.core.default.dns || !config.core.default.dns.queryStrategy){
	config.core.default.dns = {
		queryStrategy="UseIPv4"; // 强制仅查询 IPv4
		servers={
			{
				address="https+local://223.5.5.5/dns-query";
				domains={ "geosite:cn" };
				expectIPs={ "geoip:cn" };
			};
			{
				address="223.5.5.5";
				port=53;
				domains={ "geosite:cn" };
				expectIPs={ "geoip:cn" };
			};
			{
				address="https://1.1.1.1/dns-query";
				domains={ "geosite:geolocation-!cn" };
			};
			"https://1.1.1.1/dns-query";
			"tcp://8.8.8.8:53";
			"223.5.5.5";
		};
	};
}

/**intellisense(config)
__appName = 应用程序名
? = 配置文件名,\n读写配置并序列化为一个表对象,\n表的成员值可以是支持序列化的普通变量,支持table对象\n配置文件在首次使用时自动加载,退出程序时自动保存\n!fsys_table.
end intellisense**/