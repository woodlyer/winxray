//tuicJson 内核配置（TUIC）
import web.json;   

namespace v2ray.core.tuicJson;
 
write = function(jsonPath,outbound,tuicSocksPort){
    if(!outbound){ return; }
	if(type(outbound.port) != type.number){
		outbound.port = tonumber(outbound.port);
	}

	var user = outbound.user : outbound.uuid;
	var password = outbound.password : outbound.passwd;
	if(!user && outbound.id){
		var u,p = ..string.match(outbound.id,"([^\:]+)\:([^\:]+)");
		if(u && p){
			user = u;
			if(!password) password = p;
		}
		else {
			user = outbound.id;
		} 
	}
	elseif(user && !password && outbound.id){
		var u,p = ..string.match(outbound.id,"([^\:]+)\:([^\:]+)");
		if(u && p){
			password = p;
		}
	}

	var alpnList = {"h3"};
	if(outbound.alpn){
		if(type(outbound.alpn) == type.table){
			alpnList = outbound.alpn;
		}
		elseif(type(outbound.alpn) == type.string && #outbound.alpn){
			alpnList = ..string.split(outbound.alpn,",");
		}
	}

	var congestion = outbound.congestion_control : outbound.congestionController : outbound.congestion : "bbr";
	var udpMode = outbound.udp_relay_mode : outbound.udpRelayMode : "native";
	var skipCert = (outbound.allowInsecure || outbound.skip_cert_verify || outbound.skipCertVerify) ? true : false;
	var zeroRtt = (outbound.zero_rtt_handshake || outbound.zeroRtt) ? true : false;
	var disableSni = (outbound.disable_sni || outbound.disableSni) ? true : false;
	var sniHost = outbound.sni;
	if(!#sniHost && !disableSni){
		sniHost = outbound.address;
	}

	var current = {
		relay = {
			server = outbound.address + ":" + outbound.port;
			uuid = user : "";
			password = password : "";
			sni = sniHost;
			alpn = alpnList;
			disable_sni = disableSni;
			congestion_control = congestion;
			udp_relay_mode = udpMode;
			zero_rtt_handshake = zeroRtt;
			skip_cert_verify = skipCert;
			heartbeat = "3s";
			timeout = "8s";
		};
		local = {
			server = "127.0.0.1:" + tuicSocksPort;
		};
		log_level = outbound.log_level : outbound.logLevel : "error";
	};

	if(outbound.ip){
		current.relay.ip = outbound.ip;
	}

	..string.save(jsonPath,..web.json.stringify(current,true,false) );
	return jsonPath;
}
