//tuic 内核进程（TUIC）
import fsys;
import wsock.tcp.server;
import v2ray.core.tuicJson;
import process.popen;
import config;

namespace v2ray.core.tuic;

var prcsTuic;
import process.job.limitKill;
restart = function(editor,outbound,tuicSocksPort){
 
	if(prcsTuic){
		prcsTuic.terminate();
		prcsTuic = null;
	}

	var corePath = getPath(editor.hwnd);
	if(!corePath){ return false,"启动失败,未找到 tuic-client.exe"; } 

	import v2ray.core.tuicJson;
	var configPath = ..io.joinpath(..io.splitpath(corePath).dir,"config.json");
	var jsonPath,err = ..v2ray.core.tuicJson.write(configPath,outbound,tuicSocksPort);

	if(!jsonPath){
		return false,err:"启动失败,写入 TUIC 配置文件遇到错误！"; 
	}
	 
	var err;
	prcsTuic,err = ..process.popen(corePath,corePath,"-c","config.json" );
	if(!prcsTuic){
		..publish("uiCommand.print",err:"启动 TUIC Core 时遇到未知错误!");  
		return;
	}
	else{
		..publish("uiCommand.print","TUIC Core 已启动，端口:" + tuicSocksPort);  
	}
	prcsTuic.assignToJobObject(process.job.limitKill);
	prcsTuic.codepage = 65001;	
	prcsTuic.logResponse(editor); 
	 
	return true;
}

stop = function(){
	if(prcsTuic){
		prcsTuic.terminate();
		prcsTuic = null;
	} 
}

var getTuicCoreUrl = function(){
    var msgDlg = ..win.dlg.message(..mainForm); 
	var form = msgDlg.create('正在获取 TUIC Core 最新版本',,true)
	form.icon = '\uF1D8';
	form.progress.startProgress(50); 
	
	var url,versionTag = ..win.invoke(function(){
    	import process;
		import inet.http;
		var http = ..inet.http();
		var url = http.location("https://github.com/tuic-protocol/tuic/releases/latest");
		http.close();
		
		var tag = "tuic-client-1.0.0";
		if(url){
			var t = ..string.match(url,"[^/]+$");
			if(t && (t!="latest")) tag = t;
		}

		var arch = ..process().isWow64() ? "x86_64" : "i686";
		return "https://github.com/tuic-protocol/tuic/releases/download/" 
			+ tag + "/tuic-client-1.0.0-" + arch + "-pc-windows-msvc.exe", tag	
	});
	
	form.close();
	
	return url,versionTag; 
}

downloadCore = function(){
	..mainForm.disabled = true;

	var url,versionTag = getTuicCoreUrl();
	var coreDir = getCoreDir();
	if(!url) {
		..publish("uiCommand.print","请下载 TUIC Core 解压到以下目录内:");
		..publish("uiCommand.print",coreDir);
		
		..mainForm.disabled = false;
		self.lastDownloadingCoreFailed = true;
		return null;
	}
	
	import inet.httpFile;
	import zlib.httpFile;
	var targetExe = ..io.joinpath(coreDir,"tuic-client.exe");
	..io.createDir(coreDir);

	var ok = false;
	if(..string.endWith(url,".exe",true)){
		ok = ..inet.httpFile.download(url,"正在下载 TUIC Core",..io.appData("/winXray/download/tuic-client.exe"),targetExe,,..mainForm.hwnd);
	}
	else {
		ok = ..zlib.httpFile.download(url,"正在下载 TUIC Core",..io.appData("/winXray/download/tuic"),coreDir,,..mainForm.hwnd);
	}

	if(ok){
		..fsys.enum( coreDir, "tuic*.exe",
			function(dir,filename,fullpath,findData){ 
				if(filename && (filename != "tuic-client.exe")){  
					..fsys.copy(fullpath,targetExe);
					return false;
				}
			} 
		);
			
		..mainForm.disabled = false;
		self.lastDownloadingCoreFailed = null;
		
		return ..io.exist(targetExe);
	}
	else {
		..mainForm.disabled = false;
		self.lastDownloadingCoreFailed = true;
		
		..publish("uiCommand.print","请到以下网址下载 TUIC Core (tuic-client.exe):");
		..publish("uiCommand.print",url);
		
		..publish("uiCommand.print","下载后请保存到以下目录内:");
		..publish("uiCommand.print",coreDir); 
	} 	
}
 
getPath = function(hwnd){
	var path = ..io.fullpath("/xray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}

	var path = ..io.fullpath("/v2ray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}
		
	var path = ..io.appData("/winXray/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}
	
	if(self.lastDownloadingCoreFailed){
		return;
	}

	return downloadCore();
} 

getCoreDir = function(hwnd){
	var path = ..io.fullpath("/xray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/xray-core/tuic-core/");
	}

	var path = ..io.fullpath("/v2ray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/v2ray-core/tuic-core/");
	}
		
	var path = ..io.appData("/winXray/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.appData("/winXray/tuic-core/");
	}
	
	var path = ..io.fullpath("/xray-core/xray.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/xray-core/tuic-core/");
	}

	var path = ..io.fullpath("/v2ray-core/v2ray.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/v2ray-core/tuic-core/");
	}
		
	var path = ..io.appData("/winXray/core/xray.exe");
	if(..io.exist(path)){
		return ..io.appData("/winXray/tuic-core/");
	}

	var path = ..io.appData("/winXray/core/v2ray.exe");
	if(..io.exist(path)){
		return ..io.appData("/winXray/tuic-core/");
	}
	
	var path = ..io.fullpath("/xray-core/");
	if(..io.exist(path)){
		return ..io.fullpath("/xray-core/tuic-core/");
	}

	var path = ..io.fullpath("/v2ray-core/");
	if(..io.exist(path)){
		return ..io.fullpath("/v2ray-core/tuic-core/");
	}
		
	return ..io.appData("/winXray/tuic-core/");
} 

updateCore = function(){
  	..mainForm.disabled = true; 
  	
	var coreDir = getCoreDir(); 
	var url,versionTag = getTuicCoreUrl();
	if(!url){		
		..mainForm.disabled = false;
		self.lastDownloadingCoreFailed = true;
		return null;
	}
	
	import fsys;
	fsys.delete(..io.appData("/winXray/temp/tuic/"))
 
	import inet.httpFile;
	import zlib.httpFile;
	var targetExe = ..io.joinpath(coreDir,"tuic-client.exe");
	var tempExe = ..io.appData("/winXray/temp/tuic/tuic-client.exe");
	..io.createDir(..io.appData("/winXray/temp/tuic/"));

	var ok = false;
	if(..string.endWith(url,".exe",true)){
		ok = ..inet.httpFile.download(url,"正在下载 TUIC Core，版本：" + versionTag,..io.appData("/winXray/download/tuic-client.exe"),tempExe,,..mainForm.hwnd);
	}
	else {
		ok = ..zlib.httpFile.download(url,"正在下载 TUIC Core，版本：" + versionTag,..io.appData("/winXray/download/tuic/"),..io.appData("/winXray/temp/tuic/"),,..mainForm.hwnd);
	}

	if( ok ){
		..mainForm.disabled = false;
		
		var tuicPath;
		if(..io.exist(tempExe)){
			tuicPath = tempExe;
		}
		else {
			fsys.enum( ..io.appData("/winXray/temp/tuic/"), "tuic*.exe",
				function(dir,filename,fullpath,findData){ 
					if(filename){ 
						tuicPath = fullpath; 
						return false;
					}
				} 
			);
		}
		
		if(tuicPath){
			import sysProxy;
			sysProxy.reset(false);

			import process.file;
			process.file.terminate(targetExe); 
			
			..io.createDir(coreDir);  
			fsys.copy(tuicPath,targetExe);  
			
			self.lastDownloadingCoreFailed = null;
			return versionTag;
		} 
		else {
			self.lastDownloadingCoreFailed = true;
		} 
	}
	else {
		..mainForm.disabled = false;
		self.lastDownloadingCoreFailed = true; 
	}  
}

/**intellisense(v2ray.core.tuic) 
restart(.(editor,outbound) = 重启启动 TUIC 服务进程
lastDownloadingCoreFailed = 上次下载 Core 是否失败,如果希望重新下载请重新赋值为 null
end intellisense**/
