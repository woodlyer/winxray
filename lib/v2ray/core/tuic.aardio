//tuic 内核进程（TUIC）
import fsys;
import wsock.tcp.server;
import v2ray.core.tuicJson;
import process.popen;
import config;
import win.dlg.message;
import inet.downBox;

namespace v2ray.core.tuic;

var prcsTuic;
import process.job.limitKill;
restart = function(editor,outbound,tuicSocksPort){
 
	if(prcsTuic){
		prcsTuic.terminate();
		prcsTuic = null;
	}

	var corePath = getPath(editor.hwnd);
	if(!corePath){ return false,"启动失败,未找到 tuic-client.exe"; } 

	import v2ray.core.tuicJson;
	var configPath = ..io.joinpath(..io.splitpath(corePath).dir,"config.json");
	var jsonPath,err = ..v2ray.core.tuicJson.write(configPath,outbound,tuicSocksPort);

	if(!jsonPath){
		return false,err:"启动失败,写入 TUIC 配置文件遇到错误！"; 
	}
	 
	var err;
	prcsTuic,err = ..process.popen(corePath,corePath,"-c","config.json" );
	if(!prcsTuic){
		..publish("uiCommand.print",err:"启动 TUIC Core 时遇到未知错误!");  
		return;
	}
	else{
		..publish("uiCommand.print","TUIC Core 已启动，端口:" + tuicSocksPort);  
	}
	prcsTuic.assignToJobObject(process.job.limitKill);
	prcsTuic.codepage = 65001;	
	prcsTuic.logResponse(editor); 
	 
	return true;
}

stop = function(){
	if(prcsTuic){
		prcsTuic.terminate();
		prcsTuic = null;
	} 
}

var getTuicCoreUrl = function(){
    var msgDlg = ..win.dlg.message(..mainForm); 
	var form = msgDlg.create('正在获取 TUIC Core 最新版本',,true);
	form.icon = '\uF1D8';
	form.progress.startProgress(50); 
	
	var url,versionTag = ..win.invoke(function(){
    	import process;
		import inet.http;
		var http = ..inet.http();
		var loc = http.location("https://github.com/Itsusinn/tuic/releases/latest");
		http.close();
		
		var tag;
		if(loc){
			tag = ..string.match(loc,"[^/]+$");
		}
		if(!tag || (tag=="latest")) tag = "v2.0.0-dev7";
		
		var arch = ..process().isWow64() ? "x86_64" : "i686";
		return "https://github.com/Itsusinn/tuic/releases/download/" 
			+ tag + "/tuic-client-" + arch + "-windows.exe", tag;	
	});
	
	form.close();
	
	return url,versionTag; 
}

downloadCore = function(parentForm){
	var parent = parentForm : ..mainForm;

	var url,versionTag = getTuicCoreUrl();
	var coreDir = getCoreDir();
	if(!url) {
		..publish("uiCommand.print","请下载 TUIC Core 保存到以下目录内:");
		..publish("uiCommand.print",coreDir);
		
		self.lastDownloadingCoreFailed = true;
		return null;
	}
	
	import inet.downBox;
	var targetExe = ..io.joinpath(coreDir,"tuic-client.exe");
	..io.createDir(coreDir);

	var downBox = ..inet.downBox(parent,"正在下载 TUIC Core",true);
	if(!downBox){
		self.lastDownloadingCoreFailed = true;
		return null;
	}
	var ok = downBox.download(url, targetExe);

	if(ok && ..io.exist(targetExe)){
		self.lastDownloadingCoreFailed = null;
		return targetExe;
	}
	else {
		self.lastDownloadingCoreFailed = true;
		
		..publish("uiCommand.print","请到以下网址下载 TUIC Core (tuic-client.exe):");
		..publish("uiCommand.print",url);
		
		..publish("uiCommand.print","下载后请保存到以下目录内:");
		..publish("uiCommand.print",coreDir); 
	} 	
}
 
getPath = function(hwnd){
	var path = ..io.fullpath("/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}

	var path = ..io.fullpath("/xray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}

	var path = ..io.fullpath("/v2ray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}
		
	var path = ..io.appData("/winXray/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return path;
	}
	
	if(self.lastDownloadingCoreFailed){
		return;
	}

	return downloadCore();
} 

getCoreDir = function(hwnd){
	var path = ..io.fullpath("/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/tuic-core/");
	}

	var path = ..io.fullpath("/xray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/xray-core/tuic-core/");
	}

	var path = ..io.fullpath("/v2ray-core/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.fullpath("/v2ray-core/tuic-core/");
	}
		
	var path = ..io.appData("/winXray/tuic-core/tuic-client.exe");
	if(..io.exist(path)){
		return ..io.appData("/winXray/tuic-core/");
	}
	
	if(..io.exist(..io.fullpath("/tuic-core/"))){
		return ..io.fullpath("/tuic-core/");
	}
	
	if(..io.exist(..io.fullpath("/xray-core/")) || ..io.exist(..io.fullpath("/v2ray-core/"))){
		return ..io.fullpath("/tuic-core/");
	}
		
	return ..io.appData("/winXray/tuic-core/");
} 

updateCore = function(parentForm){
	var parent = parentForm : ..mainForm;
  	
	var coreDir = getCoreDir(); 
	var url,versionTag = getTuicCoreUrl();
	if(!url){		
		self.lastDownloadingCoreFailed = true;
		return null;
	}
	
	import fsys;
	fsys.delete(..io.appData("/winXray/temp/tuic/"));
 
	import inet.downBox;
	var targetExe = ..io.joinpath(coreDir,"tuic-client.exe");
	var tempExe = ..io.appData("/winXray/temp/tuic/tuic-client.exe");
	..io.createDir(..io.appData("/winXray/temp/tuic/"));

	var downBox = ..inet.downBox(parent,"正在下载 TUIC Core，版本：" + versionTag,true);
	if(!downBox){
		self.lastDownloadingCoreFailed = true;
		return null;
	}
	var ok = downBox.download(url, tempExe);

	if( ok && ..io.exist(tempExe) ){
		import sysProxy;
		sysProxy.reset(false);

		import process.file;
		process.file.terminate(targetExe); 
		
		..io.createDir(coreDir);  
		fsys.copy(tempExe,targetExe);  
		
		self.lastDownloadingCoreFailed = null;
		return versionTag;
	}
	else {
		self.lastDownloadingCoreFailed = true; 
	}  
}

/**intellisense(v2ray.core.tuic) 
restart(.(editor,outbound) = 重启启动 TUIC 服务进程
lastDownloadingCoreFailed = 上次下载 Core 是否失败,如果希望重新下载请重新赋值为 null
end intellisense**/
